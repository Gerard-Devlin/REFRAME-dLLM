    "text": "def find_max(words):\n    if not words:\n        return None:\n        return None\n\n    max_unique_chars =  0\n    max_word = None\n\n    for word in words:\n        unique = len(list(set(word))\n        if len(set(word) > max_unique:\n            max_unique = unique\n            max_word = word\n        elif len(set(word) == max_unique and word < max_word:\n            max_word = word\n\n    return max_word\n\n\n# Test cases:\nprint(find_max\nprint(find_max([\"name\", \"of\", \"string\"]))  # Output: \"string\"\nprint(find_max([\"name\", \"enam\", \"game\"]))  # Output: \"enam\"\nprint(find_max([\"aaaaaaa\", \"bb\", \"cc\"]))  # Output: \"aaaaaaa\"",
