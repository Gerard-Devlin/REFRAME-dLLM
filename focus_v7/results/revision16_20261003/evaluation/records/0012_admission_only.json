  "result": {
    "text": "from typing import List, Tuple\n\n\n\n\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"  From a list of integers numbers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n    result = []\n    for i in range(range(len(numbers)):\n        result.append(max(numbers[:i+1]))\n    result.reverse()\n    return result\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()",
