    "text": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces with  underscores,  and \n    if a string has more than two  consecutive spaces  spaces, \n    replace all consecutive spaces  with - \n    \n    \"\"\"\n    (\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   - 3\") == \"_Example-3\n    \"\"\"\n    text = text.replace(text)\n    text = text.replace(' ', '_')\n    \"\"\" \n    text.replace()\n    return text\n    return text\n    return text\n    \"\"\"\n    return text",
