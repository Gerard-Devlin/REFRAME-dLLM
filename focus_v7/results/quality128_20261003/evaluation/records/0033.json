    "text": "def numerical_letter_grade(grades):\n    letter_g_grades = []\n    for grade, gpa in grades:\n        if grade >= 4.0:\n            letter_grades.append('A+')') \n        \n        elif grade >= 3.7: \n            letter_grades.append('A-')\n        elif  grade >= 3.3:\n            letter_grades.append('A')\n        elif grade >= 3.0:\n            letter_grades.append('B+')\n        elif  grade >= 2.7:\n            letter_grades.append('B')\n        elif grade >= 2.3:\n            letter_grades.append('C-')\n        elif grade >= 1.7:\n            letter_grades.append('C')\n        else: >= 1.0:\n            letter_grades.append('D+')\n    return [letter for letter in letter_grades]",
