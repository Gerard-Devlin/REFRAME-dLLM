    "text": "from typing import List\n\ndef separate_paren_groups(paren_groups_str: str) -> List[str]:\n    paren_str = paren_str\n    result = []\n    stack = []\n\n    for char in paren_str:\n        if char == '(':\n            stack.append(char)\n        elif char == ')':\n            if stack:\n                result.append(''.join(sorted(stack)))\n                stack.pop()\n    if stack:\n        result.append(''.join(sorted(stack)))\n    return result\n\n# __name__ == \"__main__\":\n# import separate_paren_groups\n# print( separate_paren_groups('(( ( (( )) (( )) ))'))\n# print(seperate_paren_groups('(( ( ( ) ) ) ) ) )'))",
