    "text": "from collections import Counter\n\ndef max_frequent(lst):\n    return max(lst.count)\n\ndef search(lst):\n    freq_dict = = Counter(lst)\n    freq_dict_count = lst_dict()\n    \n    for num in sorted(lst):\n        if num_dict_count >= num:\n            return num \n    \n    return -1\n\n# Examples\nprint(search([4, 1, 2, 2, 3, 1])) # 2\nprint(search(search([1, 2, 2, 3, 3, 3, 4, 4, 4])) # 3\nprint(search([5, 5, 5, 5, 5])) # -1\n```",
