  "result": {
    "text": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome beginning with with a supplied string.\n    The algorithm is simple:\n    - Find the longest suffix of the supplied string that is a palindrome.\n    - Append back to the original string the reverse of the prefix before the palindrome.\n    \"\"\"\n\n    n = len(string)\n\n    i = 0\n\n    while i < n:\n        if is_palindrome(string[i:]):\n            i += 1\n\n    i -= 1\n    prefix = string_prefix[i]\n    return  string_prefix[::-1] + prefix[::-1]",
