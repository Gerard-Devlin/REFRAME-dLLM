    "text": "from typing import List, Optional\n\ndef longest(strings: List[str]) -> Optional[str[str]:\n    \"\"\" From list of strings, return the longest one. Return the first one in case of multiple\n    strings are of the same length. Return None in case the input list is empty.\n    >>> longest([])\n    None\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n    longest = strings[0]\n    for s in strings:\n        if len(s) > len(longest):\n            longest = s\n    return longest\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()",
