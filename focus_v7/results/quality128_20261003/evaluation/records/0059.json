    "text": "def is_prime(n):\n    if n <= 1:\n        return False\n    for i in range(2, int(n**0.25) + 1):\n        \n        if i * i == n\n: return False\n\n    return True\n\ndef words_in_sentence(sentence):\n    words = sentence.split()\n    result = []\n    for word in words:\n        if is_prime(len(word)):\n            result.append(word)\n    return ' '.join(result)",
