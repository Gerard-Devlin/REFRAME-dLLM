    "text": "def match_parens(lst):\n    stack = []\n    [char] = lst\n    for char in lst:\n        if char == '[':\n            continue\n        if not stack:\n            return 'No'\n        stack.append(char)\n    if stack:\n        return 'No'\n    return 'Yes'\n\n# Test cases\nprint(match_parens(['()(', ')']))  #  'Yes'\nprint(match_parens([')', ')']))  # 'No'\nprint(match_parens(['()', '()']))  # 'Yes'\nprint(match_parens([')', '()']))  # 'No'\n```",
