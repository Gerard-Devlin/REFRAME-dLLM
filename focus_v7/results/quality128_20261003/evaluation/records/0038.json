  "result": {
    "text": "def order_by_points(nums):\n    \"\"\"\n    Write a function that sorts the given list of integers \n    in ascending order based on the sum of their digits\n    according to the sum of their digits.\n    \"\"\"\n    return sorted(nums, key=lambda x: (sum(int(digit) for digit in str(x)), x.index))\n\n# Test cases\nprint(order_by_points([1, 11, -1, -11, -12]))\nprint(order_by_points([-1, -11, -12, 11, 1]))\nprint(order_by_points([]))\nprint(order_by_points([1, 2, 3, 4]))\nprint(order_by_points([1, 2, 3, 4, 5]))\n",
