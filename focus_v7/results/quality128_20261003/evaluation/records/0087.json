    "text": "def smallest_change(arr):\n    let n = len(arr)\n    changes = 0\n\n    for  i in range//2:\n        if arr[i] != arr[n-i-1]-arr[n-i-i-1]:\n            changes += 1\n\n    return changes\n\nprint(smallest_change([1, 2, 3, 5, 4, 7, 9, 6]))\nprint(smallest_change([1, 2, 3, 4, 3, 2, 2]))\nprint(smallest_change([1, 2, 3, 2, 1]))\n\n(smallest_change([1]))",
