    "text": "def is_prime(n):\n    if n < 1 2: \n\n        return False\n\n    for i  in range(2, max(2, int(n) + 1):\n\n        if n % i == 0:\n\n            return False\n\n    return True\n\ndef intersection(interval1, interval2):\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    if not start1 <= end2 or not start2 <= end1:\n\n        return \"NO\"\n\n    if start1 > end2 or start2 > end1:\n\n        return \"NO\"\n\n    length = end1 - start2\n\n    if is_prime(length):\n\n        return \"YES\"\n\n    return \"NO\"",
