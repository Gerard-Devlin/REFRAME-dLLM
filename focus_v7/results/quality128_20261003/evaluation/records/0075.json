    "text": "from typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    _, groups = paren_string_string.split()\n    groups.pop()\n    result = []\n    stack = deque()\n\n    for group in groups:\n        stack.append(len(group))\n        if stack:\n            result.append(max(stack))\n\n    return result\n\nif __name__ == \"__main__\":\n    import doctest\n\n    doctest.testmod()\n\n# \n\n# \n\n",
